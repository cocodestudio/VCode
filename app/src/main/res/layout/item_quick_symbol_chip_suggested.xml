<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="@color/vcode_text_primary"
    android:textSize="13sp"
    app:chipBackgroundColor="@color/vcode_bg_elevated"
    app:chipCornerRadius="999dp"
    app:chipIcon="@drawable/ic_plus"
    app:chipIconSize="15dp"
    app:chipIconTint="@color/vcode_text_secondary"
    app:chipStrokeColor="@color/vcode_outline"
    app:chipStrokeWidth="1dp"
    app:closeIconVisible="false" />
