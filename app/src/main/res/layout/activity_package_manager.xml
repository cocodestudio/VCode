<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Toolbar: Back Navigation, Title, Subtitle, and Select All -->
    <LinearLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vcode_app_toolbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vcode_package_manager"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_select_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/vcode_select_all"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/vcode_accent_primary"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Segmented Tab Track: Installed (Count) | Explore NPM -->
    <LinearLayout
        android:id="@+id/layout_tab_track"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/vcode_bg_pill_tab_track"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_installed"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            android:stateListAnimator="@null"
            android:text="@string/vcode_tab_installed_plain"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp"
            app:icon="@drawable/ic_circle_check"
            app:iconSize="14dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_tab_search"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            android:stateListAnimator="@null"
            android:text="@string/vcode_tab_explore_npm"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/vcode_on_primary"
            app:backgroundTint="@color/vcode_accent_primary"
            app:elevation="0dp"
            app:icon="@drawable/ic_globe"
            app:iconSize="14dp"
            app:iconTint="@color/vcode_on_primary" />
    </LinearLayout>

    <!-- Search & Filter Bar -->
    <LinearLayout
        android:id="@+id/layout_search_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/colorSurfaceContainerHigh"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_magnifying_glass"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/vcode_search_packages_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/btn_clear_search"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_xmark"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Live Operation Status Banner (High-Density Status Container) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/vcode_outline"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progress_status_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminateTint="@color/vcode_accent_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_status_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold"
                        tools:text="Downloading axios-1.7.9.tgz" />

                    <TextView
                        android:id="@+id/tv_status_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="42% completed • unpacking tree" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/loading_indicator"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                app:indicatorColor="@color/vcode_accent_primary"
                app:trackColor="@color/vcode_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Main Content: RecyclerView & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_packages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_package_card" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/iv_empty_icon"
                android:layout_width="@dimen/vcode_empty_state_icon_size"
                android:layout_height="@dimen/vcode_empty_state_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_box"
                app:tint="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/vcode_no_packages_found"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/vcode_no_packages_found_desc"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>

    <!-- Batch Selection Header / Action Bar: Docked at bottom when items are selected -->
    <LinearLayout
        android:id="@+id/layout_batch_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="2 selected" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Batch Update Button (Installed tab) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_batch_update"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/vcode_batch_update"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/vcode_accent_warning"
            android:visibility="gone"
            app:backgroundTint="@color/vcode_warning_tint"
            tools:visibility="visible" />

        <!-- Batch Uninstall Button (Installed tab) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_batch_uninstall"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/vcode_uninstall_selected"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/vcode_accent_error"
            android:visibility="gone"
            app:backgroundTint="@color/vcode_error_container"
            tools:visibility="visible" />

        <!-- Batch Dev Install Button (Search tab) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_batch_install_dev"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/vcode_install_dev_selected"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            app:strokeColor="@color/vcode_outline" />

        <!-- Batch Install Button (Search tab) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_batch_install"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="@string/vcode_install_selected"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            app:backgroundTint="@color/vcode_accent_primary" />
    </LinearLayout>

</LinearLayout>
