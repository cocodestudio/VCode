<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="14dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/vcode_bg_surface"
        app:cardCornerRadius="360dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/vcode_divider"
        app:strokeWidth="0dp">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lspToolbarRoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Go to Definition -->
                <ImageView
                    android:id="@+id/btnDefinition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:src="@drawable/ic_code"
                    app:tint="@color/vcode_text_primary"
                    android:contentDescription="@string/vcode_lsp_go_to_definition" />

                <!-- Find References -->
                <ImageView
                    android:id="@+id/btnReferences"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:src="@drawable/ic_magnifying_glass"
                    app:tint="@color/vcode_text_primary"
                    android:contentDescription="@string/vcode_lsp_find_references" />

            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
