<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_snackbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="@dimen/vcode_margin_medium"
    android:layout_marginEnd="@dimen/vcode_margin_medium"
    android:layout_marginBottom="@dimen/vcode_margin_medium"
    app:cardBackgroundColor="@color/vcode_bg_card"
    app:cardCornerRadius="@dimen/vcode_card_corner_radius"
    app:cardElevation="0dp"
    app:cardMaxElevation="0dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/vcode_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/iv_snackbar_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_circle_check"
            app:tint="@color/vcode_accent_success"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_snackbar_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/vcode_text_primary"
            android:textSize="@dimen/vcode_text_size_body_small"
            tools:text="Settings exported successfully to VCodeProjects" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_snackbar_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/vcode_text_size_caption"
            android:includeFontPadding="false"
            app:cornerRadius="@dimen/vcode_button_corner_radius"
            app:strokeColor="@color/vcode_divider"
            app:strokeWidth="1dp"
            android:visibility="gone"
            tools:text="Copy Path"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/btn_snackbar_dismiss"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/vcode_dismiss"
            android:padding="5dp"
            android:src="@drawable/ic_xmark"
            android:visibility="gone"
            app:tint="@color/vcode_text_secondary"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
