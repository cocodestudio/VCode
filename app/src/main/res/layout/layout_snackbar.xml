<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_snackbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginStart="@dimen/vcode_margin_medium"
    android:layout_marginEnd="@dimen/vcode_margin_medium"
    android:layout_marginBottom="@dimen/vcode_margin_large"
    app:cardBackgroundColor="@color/vcode_bg_surface"
    app:cardCornerRadius="@dimen/vcode_card_corner_radius"
    app:cardElevation="@dimen/vcode_spacing_micro"
    app:cardMaxElevation="@dimen/vcode_spacing_micro"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:strokeColor="@color/vcode_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vcode_padding_medium"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/vcode_padding_medium"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/iv_snackbar_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_circle_check"
            app:tint="@color/vcode_accent_success"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_snackbar_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="3"
            android:textColor="@color/vcode_text_primary"
            android:textSize="@dimen/vcode_text_size_body"
            tools:text="Settings exported successfully to VCodeProjects" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_snackbar_action"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/vcode_spacing_small"
            android:minWidth="0dp"
            android:minHeight="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/vcode_text_size_body_small"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:cornerRadius="@dimen/vcode_button_corner_radius"
            android:visibility="gone"
            tools:text="COPY PATH"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/btn_snackbar_dismiss"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/vcode_spacing_small"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/vcode_dismiss"
            android:padding="3dp"
            android:src="@drawable/ic_xmark"
            android:visibility="gone"
            app:tint="@color/vcode_text_secondary"
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
