<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_package"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/vcode_bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/vcode_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header: Selection Checkbox, Name, Scope Badge, Version Flow, and Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:buttonTint="@color/vcode_accent_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Package Name and Scope Badge Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_package_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/vcode_text_primary"
                        android:textStyle="bold"
                        tools:text="axios" />

                    <TextView
                        android:id="@+id/tv_scope_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/vcode_bg_badge_success"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/vcode_accent_success"
                        android:textStyle="bold"
                        tools:text="prod" />
                </LinearLayout>

                <!-- Version Flow / Status Row -->
                <LinearLayout
                    android:id="@+id/layout_version_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_installed_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/vcode_text_hint"
                        tools:text="v1.6.2" />

                    <ImageView
                        android:id="@+id/iv_version_arrow"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right"
                        android:visibility="gone"
                        app:tint="@color/vcode_accent_warning"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_latest_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/vcode_accent_warning"
                        android:textStyle="bold"
                        tools:text="v1.7.9" />

                    <TextView
                        android:id="@+id/tv_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/vcode_bg_badge_warning"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@color/vcode_accent_warning"
                        tools:text="Update available" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_more_options"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/vcode_package_options"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_ellipsis_vertical"
                app:tint="@color/vcode_text_hint" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tv_package_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/vcode_text_secondary"
            tools:text="Promise based HTTP client for the browser and node.js with rich interceptor support." />

        <!-- Metadata row: Author • License • Unpacked Size -->
        <LinearLayout
            android:id="@+id/layout_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/vcode_text_hint"
                tools:text="By Matt Zabriskie" />

            <TextView
                android:id="@+id/tv_dot_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="•"
                android:textColor="@color/vcode_text_hint" />

            <TextView
                android:id="@+id/tv_license"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/vcode_text_hint"
                tools:text="MIT" />

            <TextView
                android:id="@+id/tv_dot_license"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="•"
                android:textColor="@color/vcode_text_hint" />

            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/vcode_text_hint"
                tools:text="420 KB" />
        </LinearLayout>

        <!-- In-Progress Status Section on Card -->
        <LinearLayout
            android:id="@+id/layout_item_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/vcode_bg_badge_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/progress_action"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="@color/vcode_accent_primary" />

            <TextView
                android:id="@+id/tv_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/vcode_accent_primary"
                android:textStyle="bold"
                tools:text="Installing..." />
        </LinearLayout>

        <!-- Card Action Row: Dependency Type Tag + Dynamic Action Buttons -->
        <LinearLayout
            android:id="@+id/layout_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_dependency_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/vcode_text_hint"
                tools:text="Direct Dependency" />

            <!-- Uninstall Button (Trash Icon) -->
            <ImageView
                android:id="@+id/btn_uninstall"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_trash"
                android:visibility="gone"
                app:tint="@color/vcode_accent_error"
                tools:visibility="visible" />

            <!-- Install Dev Button (+Dev) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_install_dev"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="@string/vcode_install_dev"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                app:strokeColor="@color/vcode_outline" />

            <!-- Install Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_install"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/vcode_install"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                app:backgroundTint="@color/vcode_accent_primary" />

            <!-- Update Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_update"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="@string/vcode_update"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/vcode_accent_warning"
                android:textSize="11sp"
                android:visibility="gone"
                app:backgroundTint="@color/vcode_warning_tint"
                app:icon="@drawable/ic_arrows_rotate"
                app:iconSize="13dp"
                app:iconTint="@color/vcode_accent_warning"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
