<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vcode_bg_surface"
    android:fitsSystemWindows="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/vcode_bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/vcode_accent_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/vcode_bg_symbol_key"
            android:defaultFocusHighlightEnabled="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            tools:targetApi="26">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/vcode_accent_success" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/vcode_text_primary"
                android:textSize="12sp"
                tools:text="localhost:3000/index.html" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_arrows_rotate"
            app:tint="@color/vcode_text_secondary" />

        <ImageView
            android:id="@+id/btn_open_browser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_globe"
            app:tint="@color/vcode_text_secondary" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        app:indicatorColor="@color/vcode_accent_primary"
        app:trackColor="@android:color/transparent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/layout_viewport"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <WebView
                    android:id="@+id/web_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layout_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_triangle_exclamation"
                    app:tint="@color/vcode_accent_error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/vcode_page_could_not_load"
                    android:textColor="@color/vcode_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_error_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:textColor="@color/vcode_text_secondary"
                    android:textSize="14sp"
                    tools:text="ERR_FILE_NOT_FOUND" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_try_again"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/vcode_try_again_btn"
                    android:textColor="@color/vcode_text_primary"
                    app:strokeColor="@color/vcode_divider" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/vcode_bg_symbol_key"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/btn_vp_phone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_mobile"
                app:tint="@color/vcode_accent_primary" />

            <ImageView
                android:id="@+id/btn_vp_tablet"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_tablet_screen"
                app:tint="@color/vcode_text_secondary" />

            <ImageView
                android:id="@+id/btn_vp_desktop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_monitor"
                app:tint="@color/vcode_text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_toggle_console"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_code"
            app:tint="@color/vcode_bg_surface" />
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_console"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/vcode_bg_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Drag Handle -->
            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />

            <!-- Console Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <!-- Terminal icon -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_terminal"
                    app:tint="@color/vcode_accent_primary" />

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_console_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.04"
                    android:text="@string/vcode_console_logs"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="@color/vcode_text_primary" />

                <!-- Log count badge -->
                <TextView
                    android:id="@+id/tv_console_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/vcode_bg_console_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    tools:text="0"
                    android:textColor="@color/vcode_accent_primary"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText,SmallSp" />

                <!-- Clear button -->
                <ImageView
                    android:id="@+id/btn_clear_console"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_trash"
                    app:tint="@color/vcode_accent_error" />

                <!-- Close button -->
                <ImageView
                    android:id="@+id/btn_close_console"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/ic_xmark"
                    app:tint="@color/vcode_text_secondary" />
            </LinearLayout>

            <!-- Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Log output area -->
            <ScrollView
                android:id="@+id/scroll_console"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/vcode_bg_console_log_area"
                android:fillViewport="true"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tv_console_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:padding="10dp"
                    android:textColor="@color/vcode_text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </ScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>