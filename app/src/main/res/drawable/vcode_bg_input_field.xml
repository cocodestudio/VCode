<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/vcode_bg_deep" />
            <stroke android:width="2dp" android:color="@color/vcode_accent_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/vcode_bg_deep" />
            <stroke android:width="1dp" android:color="@color/vcode_outline_variant" />
        </shape>
    </item>
</selector>
