{
  "Accept": [
    "application/json",
    "application/xml",
    "text/html",
    "text/plain",
    "application/x-www-form-urlencoded",
    "multipart/form-data",
    "*/*"
  ],
  "Accept-Charset": [
    "utf-8",
    "iso-8859-1"
  ],
  "Accept-Encoding": [
    "gzip",
    "deflate",
    "br",
    "gzip, deflate, br"
  ],
  "Accept-Language": [
    "en-US,en;q=0.9",
    "en-GB,en;q=0.8"
  ],
  "Authorization": [
    "Bearer ",
    "Basic "
  ],
  "Cache-Control": [
    "no-cache",
    "no-store",
    "max-age=3600",
    "must-revalidate"
  ],
  "Connection": [
    "keep-alive",
    "close"
  ],
  "Content-Type": [
    "application/json",
    "application/xml",
    "text/html",
    "text/plain",
    "application/x-www-form-urlencoded",
    "multipart/form-data",
    "application/javascript"
  ],
  "Origin": [
    "http://localhost:3000",
    "http://localhost:8080"
  ],
  "User-Agent": [
    "VCode/1.0"
  ],
  "X-Requested-With": [
    "XMLHttpRequest"
  ]
}
